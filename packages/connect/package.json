{
  "name": "@fenestella/connect",
  "version": "0.1.0",
  "description": "Ask a QoreChain user for exactly the EVM window your dApp or agent needs. No keys, no CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2020 --outfile=dist/index.js && tsc -p tsconfig.build.json && node fix-dts.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["qorechain", "post-quantum", "evm-window", "wallet", "dapp", "ml-dsa"],
  "homepage": "https://fenestella.vercel.app/demo",
  "repository": { "type": "git", "url": "git+https://github.com/angelraph/fenestella.git", "directory": "packages/connect" },
  "bugs": { "url": "https://github.com/angelraph/fenestella/issues" }
}
